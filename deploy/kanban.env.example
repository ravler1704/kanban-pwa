# Copy to deploy/kanban.env (not committed); ./deploy.sh uploads it to /etc/kanban/env.
# Server settings are changed in the app (Аккаунт → Настройки сервера) and kept in the database.

# Comma-separated e-mails of administrators: they see «Настройки сервера». Always administrators,
# whatever is set in the app, so the server can't be lost.
ADMIN_EMAILS=

# Read only on the first start with a new database, to set up the first way to sign in
# (sign-in is off while none is set up); afterwards change them in the app.
# OAuth client ID of type "Web application" from Google Cloud Console.
GOOGLE_CLIENT_ID=
# ClientID of the app from https://oauth.yandex.ru (the client secret is not needed).
YANDEX_CLIENT_ID=
# Sign-in by a code sent to the e-mail, e.g. for Yandex:
# smtps://login%40yandex.ru:APP-PASSWORD@smtp.yandex.ru:465 (an app password for "Почта").
SMTP_URL=
