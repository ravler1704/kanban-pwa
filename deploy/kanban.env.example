# Copy to deploy/kanban.env (not committed); ./deploy.sh uploads it to /etc/kanban/env.
# Leave GOOGLE_CLIENT_ID empty to disable sign-in.

# OAuth client ID of type "Web application" from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Optional comma-separated list of Google accounts allowed to sign in; empty means any account.
# Every account gets its own board either way.
ALLOWED_EMAILS=
