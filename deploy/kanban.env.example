# Copy to deploy/kanban.env (not committed); ./deploy.sh uploads it to /etc/kanban/env.
# Sign-in is off while both client IDs and SMTP_URL are empty.

# OAuth client ID of type "Web application" from Google Cloud Console.
GOOGLE_CLIENT_ID=
# ClientID of the app from https://oauth.yandex.ru (the client secret is not needed).
YANDEX_CLIENT_ID=
# Comma-separated e-mails of administrators: they see the «Сервер» tab and set up the mail there.
ADMIN_EMAILS=
# Sign-in by a code sent to the e-mail: the mailbox is usually set up in the app («Сервер» tab).
# SMTP_URL here takes precedence over it, e.g. for Yandex:
# smtps://login%40yandex.ru:APP-PASSWORD@smtp.yandex.ru:465 (an app password for "Почта").
SMTP_URL=
# Optional sender, e.g. "Канбан" <login@yandex.ru>; defaults to the mailbox of SMTP_URL.
MAIL_FROM=
# Contact sent to browser push services with reminders (a URL or mailto:).
VAPID_SUBJECT=https://example.com
# Optional comma-separated list of accounts (e-mails) allowed to sign in; empty means anyone.
# Every user gets their own board either way.
ALLOWED_EMAILS=
